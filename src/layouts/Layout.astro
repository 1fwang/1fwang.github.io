---
import '../styles/global.css';
import VisitorCounter from '../components/VisitorCounter.astro';
const {title='Yifu Wang 王一夫 — Generative AI & Spatial Intelligence',description='Yifu Wang (王一夫, Ian), Founding Member & COO at Vertex Lab | V2Fun.ai. Research in 3D scene generation, controllable video, digital humans, visual-inertial SLAM and event-based perception.',paper}=Astro.props;
const canonical=new URL(Astro.url.pathname,'https://1fwang.github.io');
const person={'@context':'https://schema.org','@type':'Person','@id':'https://1fwang.github.io/#person',name:'Yifu Wang',alternateName:['王一夫','Ian Wang'],url:'https://1fwang.github.io',image:'https://1fwang.github.io/images/yifu-avatar.jpg',jobTitle:'Founding Member & COO',worksFor:{'@type':'Organization',name:'Vertex Lab | V2Fun.ai'},alumniOf:{'@type':'CollegeOrUniversity',name:'Australian National University'},sameAs:['https://github.com/1fwang','https://scholar.google.com/citations?user=_0BWh_8AAAAJ']};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:type" content={paper ? "article" : "website"}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(paper?.image || "/images/yifu-avatar.jpg", "https://1fwang.github.io").href}/><meta name="twitter:card" content={paper?.image ? "summary_large_image" : "summary"}/><meta name="theme-color" content="#090909"/><script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('yw-theme')||'dark'}catch{document.documentElement.dataset.theme='dark'}</script><script type="application/ld+json" set:html={JSON.stringify(person)}/>{paper && <><meta name="citation_title" content={paper.title}/>{paper.author.split(',').map((author:string)=><meta name="citation_author" content={author.trim()}/>)}{paper.date && <meta name="citation_publication_date" content={paper.date}/>}{paper.pdf && <meta name="citation_pdf_url" content={new URL(paper.pdf,'https://1fwang.github.io').href}/>}</>}</head><body><a class="skip" href="#main">Skip to content</a><header class="header"><a class="brand" href="/">yw<span>.</span></a><nav aria-label="Main navigation"><a href="/#about">About</a><a href="/#projects">Projects</a><a href="/publications/">Research</a><a href="/cv/">CV</a><a class="nav-contact" href="/contact/">Get in touch <span>↗</span></a><button id="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme"><svg class="sun-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg><span class="moon-icon" aria-hidden="true">☾</span></button></nav></header><main id="main"><slot/></main><VisitorCounter /><footer><a class="brand" href="/">yw<span>.</span></a><span>© {new Date().getFullYear()} Yifu Wang · 王一夫</span><a href="https://github.com/1fwang">GitHub ↗</a><a href="https://scholar.google.com/citations?user=_0BWh_8AAAAJ">Google Scholar ↗</a><a href="/awards/">Awards</a></footer><script>
const toggle=document.querySelector<HTMLButtonElement>('#theme-toggle');
function syncTheme(){const dark=document.documentElement.dataset.theme!=='light';toggle?.setAttribute('aria-label',dark?'Switch to light theme':'Switch to dark theme');toggle?.setAttribute('title',dark?'Switch to light theme':'Switch to dark theme');document.querySelector('meta[name="theme-color"]')?.setAttribute('content',dark?'#090909':'#fafafa');}
syncTheme();toggle?.addEventListener('click',()=>{const theme=document.documentElement.dataset.theme==='light'?'dark':'light';document.documentElement.dataset.theme=theme;try{localStorage.setItem('yw-theme',theme)}catch{}syncTheme()});
</script></body></html>
