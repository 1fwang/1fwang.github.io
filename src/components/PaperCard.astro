---
const {paper:p}=Astro.props;
const label=p.title.includes(':')?p.title.split(':')[0]:(p.slug==='doctoral-thesis2021'?'Ph.D. Thesis':p.slug==='cross-modal-tracking2024'?'Event Tracking':p.slug==='revisit-event2023'?'Frame Interpolation':'Place Recognition');
---
<article class="paper" data-search={`${p.title} ${p.author} ${p.venue} ${p.date} ${p.year||''}`.toLowerCase()}><a href={`/${p.slug}/`} class="paper-image" aria-label={p.title}>{p.image?<img src={p.thumbnail || p.image} alt={p.imageCaption || 'Research figure: '+p.title} width="320" height="190" loading="lazy"/>:<div class="research-cover" aria-hidden="true"><span>{p.year || p.date.slice(0,4)} / RESEARCH</span><strong>{label}</strong><span>YIFU WANG & COLLABORATORS ↗</span></div>}</a><div><p class="eyebrow">{p.venue} · {p.year || p.date.slice(0,4)}</p><h2 class="paper-title"><a href={`/${p.slug}/`}>{p.title}</a></h2><p class="authors">{p.author}</p>{p.summary && <p class="paper-summary">{p.summary}</p>}<div class="paper-links"><a href={p.pdf || p.paperurl}>Paper ↗</a>{p.bib && <a href={p.bib}>BibTeX ↗</a>}{p.project && <a href={p.project}>Project / Code ↗</a>}<a href={`/${p.slug}/`}>Details ↗</a>{p.scholar && <a href={p.scholar}>Scholar ↗</a>}</div></div></article>
