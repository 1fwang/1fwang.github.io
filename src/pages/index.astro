---
import Layout from '../layouts/Layout.astro';
import PaperCard from '../components/PaperCard.astro';
import pubs from '../data/publications.json';
import news from '../data/news.json';
const projects=[{n:'01',name:'v2fun.ai',category:'AI · 3D CREATION',text:'From an idea to a world in 3D. Image generation, 3D modeling and animation, connected in one workflow.',url:'https://v2fun.ai',cls:'v2',symbol:'✳',image:'/images/v2fun-home.jpg',imageAlt:'V2Fun website — AI-powered 3D creation'},{n:'04',name:'V2Fun Research',category:'OPEN SOURCE · MAINTAINER',text:'I maintain open-source tools and AI skills for 3D modeling, character animation, dance games and multicolor 3D printing.',url:'https://github.com/V2Fun-Research/',cls:'v2research',symbol:'⌘',image:'/images/v2fun-developers.jpg',imageAlt:'V2Fun Developers — 3D generation for developers and AI agents'},{n:'02',name:'MAVIS',category:'MULTI-CAMERA VISUAL-INERTIAL SLAM',text:'Multi-camera visual-inertial SLAM with exact IMU pre-integration. Winner of the Hilti SLAM Challenge 2023 vision–IMU tracks.',url:'/mavis2024/',cls:'gv',symbol:'⌘',image:'/images/research/mavis2024.webp'},{n:'03',name:'Sketch2Scene',category:'GENERATIVE AI',text:'Explore our research project on sketch-to-scene generation.',url:'https://xrvisionlabs.github.io/Sketch2Scene/',cls:'sketch',symbol:'▧',image:'/images/research/sketch2scene2024.webp'}];
---
<Layout><section class="sphere-hero">
<div class="sphere-sky" aria-hidden="true"><div class="star-field"></div><div class="sphere-horizon"><div></div></div><div class="meteor"></div></div>
<div class="hero-content wrap"><p class="eyebrow">RESEARCHER · BUILDER · EXPLORER</p><h1>Yifu Wang<span class="chinese">王一夫 / Ian</span></h1><p class="hero-statement">Perceive the world.<br/><span>Create new possibilities.</span></p><p class="intro">Founding Member & COO at <strong>Vertex Lab | <a class="inline-link" href="https://v2fun.ai/">V2Fun.ai</a></strong><br/>Generative worlds, digital humans and spatial intelligence.</p><div class="actions"><a class="button" href="/publications/">Explore research ↗</a><a class="button secondary" href="#projects">View projects ↓</a></div><a class="hero-scholar text-link" href="https://scholar.google.com/citations?user=_0BWh_8AAAAJ">Google Scholar ↗</a></div>
<div class="hero-bottom wrap"><span>GENERATIVE AI</span><span>3D & VIDEO</span><span>SPATIAL PERCEPTION</span></div></section>
<section id="projects" class="section wrap"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>Selected projects<span>.</span></h2></div><a class="text-link" href="https://github.com/1fwang">More on GitHub ↗</a></div><div class="project-grid">{projects.map(p=><a class="project" href={p.url}><div class:list={['project-art',p.cls,p.image && (p.cls==='v2'||p.cls==='v2research'?'has-site-cover':'has-paper-figure')]}>{p.image ? <img src={p.image} alt={p.imageAlt || `${p.name} — figure from the research paper`} loading="lazy" width="720" height="420"/> : <><span class="art-index">{p.cls === 'v2research' ? 'OPEN-SOURCE TOOLS & AI SKILLS' : 'AI-POWERED 3D CREATION'}</span><span class="art-symbol">{p.cls === 'v2research' ? '</>' : '3D'}</span><span class="art-word">{p.name}</span><span class="art-arrow">↗</span></>}</div><p class="eyebrow">{p.category}</p><h3>{p.name} <span>↗</span></h3><p>{p.text}</p></a>)}</div><div class="project-extra"><span>ALSO EXPLORING</span><a href="https://github.com/Tencent/Triplet_Tuning">Triplet-Tuning ↗</a><a href="https://github.com/MAVIS-SLAM/OpenMAVIS">OpenMAVIS code ↗</a></div></section>
<section id="about" class="about-section"><div class="wrap about-grid"><div><img class="about-portrait" src="/images/yifu-avatar.jpg" alt="Yifu Wang" width="144" height="144" loading="lazy"/><p class="eyebrow">02 / A LITTLE ABOUT ME</p><h2>A vision researcher.<br/>A builder at heart<span>.</span></h2><a class="text-link" href="/cv/">My background ↗</a></div><div class="about-copy"><p>I study how machines perceive, reconstruct and generate the visual world. My research spans <strong>generative AI for 3D scenes, consistent and controllable video generation, and expressive digital avatars</strong>, alongside <strong>geometric vision, visual-inertial SLAM and event-based perception.</strong> Across these areas, I explore how spatial understanding can help machines navigate real environments and create coherent, editable virtual worlds.</p><p>I am a Founding Member and COO at Vertex Lab | <a class="inline-link" href="https://v2fun.ai/">V2Fun.ai</a>. Previously, I worked as a Senior Researcher at Tencent XR Vision Labs and as a Postdoctoral Research Fellow at the Shanghai Institute of Microsystem and Information Technology, Chinese Academy of Sciences, working with Prof. Laurent Kneip. I also served as a SLAM Technical Consultant at Motovis, leading a team on autonomous driving projects.</p><p>I received my Ph.D. from the Australian National University, advised by Prof. Laurent Kneip and Prof. Hongdong Li. My recent work connects 3D-aware memory, scene consistency and controllable generation, with applications in interactive worlds, visual storytelling and digital humans.</p><div class="tags"><span>Computer vision</span><span>Robotics</span><span>Spatial computing</span><span>Generative AI</span></div></div></div></section>
<section class="section wrap"><div class="section-heading"><div><p class="eyebrow">03 / RESEARCH</p><h2>Selected publications<span>.</span></h2></div><a class="text-link" href="/publications/">All publications ↗</a></div><div class="papers">{['storyblender2026','triplet-tuning2026','mavis2024'].map(slug=>pubs.find(p=>p.slug===slug)!).map(p=><PaperCard paper={p}/>)}</div></section>
<section class="section wrap news-section"><div><p class="eyebrow">04 / WHAT'S NEW</p><h2>Latest news<span>.</span></h2><p class="muted">Research, releases & milestones.</p></div><div><div class="news-list">{news.slice(0,6).map(n=><article class="news"><time>{n.date}</time><p set:html={n.html}/></article>)}</div><details><summary>Earlier news ↓</summary><div class="news-list">{news.slice(6).map(n=><article class="news"><time>{n.date}</time><p set:html={n.html}/></article>)}</div></details></div></section>
<section class="wrap contact-banner"><p class="eyebrow">LET'S CONNECT</p><h2>Good ideas start<br/>with a conversation<span>.</span></h2><a class="button" href="mailto:usasuper@126.com">Say hello <span>↗</span></a></section></Layout>
