---
import Layout from '../layouts/Layout.astro';
import PaperCard from '../components/PaperCard.astro';
import pubs from '../data/publications.json';
import notes from '../data/research-notes.json';
const topics=[
 {id:'scenes-avatars',name:'3D scenes & avatars',description:'From sketches and stories to editable environments, concept art and expressive digital humans.'},
 {id:'video-generation',name:'Video generation',description:'Memory, action control and visual continuity across camera movements and multiple clips.'},
 {id:'geometry-slam',name:'Geometry & SLAM',description:'Multi-camera calibration, visual-inertial mapping, geometric reconstruction and vehicle motion.'},
 {id:'event-based-vision',name:'Event-based vision',description:'Asynchronous sensing for motion estimation, tracking, place recognition and frame interpolation.'}
];
const schema={'@context':'https://schema.org','@type':'CollectionPage',name:'Publications & research insights — Yifu Wang',url:'https://1fwang.github.io/publications/',description:'Original research summaries and interpretations in generative AI, spatial intelligence, SLAM and event-based vision.',mainEntity:{'@type':'ItemList',itemListElement:topics.flatMap(t=>pubs.filter(p=>notes[p.slug as keyof typeof notes].topic===t.name)).map((p,i)=>({'@type':'ListItem',position:i+1,url:`https://1fwang.github.io/${p.slug}/`,name:p.title}))}};
---
<Layout title="Publications & Research Insights — Yifu Wang" description="Explore 25 research summaries on 3D scene generation, video consistency, talking avatars, SLAM and event cameras, with original papers and code sources.">
<script type="application/ld+json" set:html={JSON.stringify(schema)}/>
<section class="wrap page research-index">
<p class="eyebrow">RESEARCH / PUBLICATIONS</p><h1>Publications &<br/>research insights.</h1>
<p class="lead">How can machines understand physical space and create coherent visual worlds? Explore my research in generative AI and geometric vision through plain-language summaries, method explanations and links to the original work.</p>
<p class="note-caption">25 papers, preprints, a thesis and a technical report · Notes updated September 26, 2026.<br/><a class="text-link" href="https://scholar.google.com/citations?user=_0BWh_8AAAAJ">View my Google Scholar profile ↗</a></p>
<nav class="topic-navigation" aria-label="Research topics">{topics.map(t=><a href={`#${t.id}`}><strong>{t.name}</strong><span>{pubs.filter(p=>notes[p.slug as keyof typeof notes].topic===t.name).length} research notes ↓</span></a>)}</nav>
<div class="filter-bar"><label for="search">Find research</label><input id="search" type="search" placeholder="Search topic, method, title, author or year…"/></div><p id="result-count" class="muted" aria-live="polite">{pubs.length} research records</p>
{topics.map(t=><section id={t.id} class="research-topic"><h2>{t.name}</h2><p class="muted">{t.description}</p><div class="papers">{pubs.filter(p=>notes[p.slug as keyof typeof notes].topic===t.name).map(p=><PaperCard paper={p}/>)}</div></section>)}
<p class="empty" id="empty" hidden>No matching research. Try another topic, title or year.</p><p class="muted">* Equal contribution · # Corresponding author</p>
</section></Layout>
<script>
const input=document.querySelector<HTMLInputElement>('#search');
input?.addEventListener('input',()=>{const query=input.value.toLowerCase().trim();let count=0;document.querySelectorAll<HTMLElement>('[data-search]').forEach(el=>{el.hidden=!el.dataset.search?.includes(query);if(!el.hidden)count++});document.querySelectorAll<HTMLElement>('.research-topic').forEach(section=>{section.hidden=!Array.from(section.querySelectorAll<HTMLElement>('[data-search]')).some(el=>!el.hidden)});document.querySelector('#result-count')!.textContent=`${count} research record${count===1?'':'s'}`;document.querySelector<HTMLElement>('#empty')!.hidden=count>0;});
</script>
