---
import Layout from '../layouts/Layout.astro';
import pubs from '../data/publications.json';
export function getStaticPaths(){return pubs.map(p=>({params:{slug:p.slug},props:{paper:p}}))}
const {paper:p}=Astro.props;
const description=p.abstract||p.summary;
const schema={'@context':'https://schema.org','@type':'ScholarlyArticle',headline:p.title,...(p.date?{datePublished:p.date}:{}),author:p.author.split(',').map(name=>({'@type':'Person',name:name.trim().replace(/[.*#]+$/,'')})),url:`https://1fwang.github.io/${p.slug}/`,...(p.image?{image:'https://1fwang.github.io'+p.image}:{}),description};
---
<Layout title={`${p.title} — Yifu Wang`} description={description.length>160?description.slice(0,157)+'…':description} paper={p}><script type="application/ld+json" set:html={JSON.stringify(schema)}/><article class="wrap page detail"><a class="text-link" href="/publications/">← All research</a><h1>{p.title}</h1><p>{p.author}</p><p class="muted">{p.venue} · {p.year || p.date.slice(0,4)}</p><div class="paper-links">{p.pdf && <a class="button" href={p.pdf}>Read paper ↗</a>}{p.bib && <a href={p.bib}>BibTeX ↗</a>}<a href={p.paperurl}>Publication source ↗</a>{p.project && <a href={p.project}>Project / Code ↗</a>}{p.scholar && <a href={p.scholar}>Google Scholar ↗</a>}</div>{p.image && <figure class="paper-figure"><a href={p.image} aria-label="Open full-size research figure"><img src={p.image} alt={p.imageCaption || `Research overview for ${p.title}`} width={p.imageWidth} height={p.imageHeight}/></a>{p.imageSource && <figcaption>{p.imageCaption} <a href={p.imageSource}>Figure source ↗</a></figcaption>}</figure>}<h2>{p.abstract?'Abstract':'Research overview'}</h2><p>{description}</p>{p.dateNote && <p class="muted">{p.dateNote}</p>}{p.sourceChecked && <p class="muted">{p.venueSource ? `Publication venue ${p.venueSource.toLowerCase()}. Other metadata checked against Google Scholar on ${p.sourceChecked}.` : `Publication metadata checked against Google Scholar on ${p.sourceChecked}.`} Overview summarizes the research description.</p>}</article></Layout>
